# =============================================================================
# H0melab Downloader — environment configuration
#
# Copy this file to ".env" before running `docker compose up -d --build`.
# Every value below can also be changed later via the Settings tab in the UI.
# =============================================================================

# ---- Single host port (the only port exposed) -------------------------------
HOST_PORT=8080

# ---- Plex target paths on the HOST ------------------------------------------
# These are bind-mounted into the container as /movies and /tv.
# Point them at the same paths your Plex server already scans.
MOVIES_PATH=./data/movies
TV_PATH=./data/tv

# ---- Internal data dirs (state + scratch space) -----------------------------
CONFIG_PATH=./data/config
TMP_PATH=./data/tmp

# ---- Runtime tuning ---------------------------------------------------------
TZ=Europe/Berlin
LOG_LEVEL=INFO
CONCURRENCY=1
DEFAULT_LANGUAGE=de
QUALITY_PROFILE=best
HOSTER_PRIORITY=VOE,Vidmoly,Vidoza,Doodstream

# ---- Credits ----------------------------------------------------------------
HOMELAB_CREDIT=true

# =============================================================================
# TMDB API key — RECOMMENDED
# -----------------------------------------------------------------------------
# Used for richer metadata (posters, release dates, "download as soon as
# released" scheduling). The downloader works without it, but the scheduler
# and the metadata search return empty results.
#
# Get a free API key in 30 seconds:
#   1. https://www.themoviedb.org/signup
#   2. https://www.themoviedb.org/settings/api  →  "API Read Access Token (v3)"
#   3. Paste it below, then `docker compose up -d --build`
# =============================================================================
TMDB_API_KEY=

# ---- Notifications (optional) -----------------------------------------------
# Discord:  Server settings → Integrations → Webhooks → Copy URL
# Telegram: BotFather → /newbot, then your numeric chat-id from @userinfobot
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional outbound proxy (SOCKS5 or HTTP) -------------------------------
# Example: socks5://10.0.0.5:1080
PROXY_URL=
